DATABASE_URL=postgres://harbor:harbor_local@127.0.0.1:5432/harbor?sslmode=disable
HARBOR_ADDR=127.0.0.1:8080
HARBOR_ADMIN_ACCOUNT=campus_admin
# Set your own administrator password before starting the service.
HARBOR_ADMIN_PASSWORD=
# Use a stable value of 24+ characters if the console will store provider keys.
AI_ENCRYPTION_KEY=
# Optional. The backend can initialize a DeepSeek connection from this value.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# Optional absolute folder containing versioned GLB and image bundles.
HARBOR_COMPANION_DIR=
